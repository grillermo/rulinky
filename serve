#!/usr/bin/env bash
# (Re)start rulinky in tmux session "rulinky", in place, and return. Run by
# ../server/after-reboot.sh at boot and by ./activate after git-sync lands
# new code. The Go binary loads its dotenv files from this directory, and they
# (or the environment) must define SESSION_SECRET (>= 32 chars, generate with
# openssl rand -hex 32) and the database settings (DATABASE_URL or
# DATABASE_HOST/USER/PASSWORD/NAME). The binary refuses to start without them.
set -euo pipefail
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"
# shellcheck disable=SC2034 # read by serve-in-place.sh
SESSION=rulinky
# shellcheck source=/dev/null
. "$HOME/c/server/serve-in-place.sh"
# vendor/ is tracked (Rails), so go must not treat it as a Go vendor directory.
export GOFLAGS=-mod=mod

echo "==> pnpm install";   pnpm install --frozen-lockfile
echo "==> pnpm run build"; pnpm run build
echo "==> go build";       go build -o bin/rulinky ./cmd/rulinky

serve_pane web 3002 "cd '$APP_DIR' && env RULINKY_ENV=production ./bin/rulinky" /up
serve_attach
